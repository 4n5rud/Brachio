    {
      "name": "AgentChip",
      "group": "Status",
      "summary": "A small outlined tag naming the agent that runs a task."
    },
    {
      "name": "ApprovalBar",
      "group": "Tasks",
      "summary": "The request an agent is waiting on, docked under its terminal with the full request visible, so the person answers where the context is."
    },
    {
      "name": "BoardTile",
      "group": "Tasks",
      "summary": "A task as a tile in the board view, with the last lines of its terminal, so the person can scan many agents at once."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "A text button for one clear action; primary marks the single most likely next step in a view."
    },
    {
      "name": "ConfirmDialog",
      "group": "Overlays",
      "summary": "A centered dialog before a step that loses something: delete a task for good, discard a draft, sign out of Codex, forget an unknown launch."
    },
    {
      "name": "Coverage",
      "group": "Screens",
      "page": true
    },
    {
      "name": "Dialog",
      "group": "Feedback",
      "summary": "A modal that asks for confirmation before a step that cannot be undone."
    },
    {
      "name": "DiffStat",
      "group": "Status",
      "summary": "Added and removed line counts for a task's branch."
    },
    {
      "name": "EmptyState",
      "group": "Feedback",
      "summary": "What a region shows when it has nothing yet, with the one step that fills it."
    },
    {
      "name": "IconButton",
      "group": "Actions",
      "summary": "A square button holding one icon, for chrome actions people repeat often."
    },
    {
      "name": "Input",
      "group": "Inputs",
      "summary": "A text field with its label above it, for the new task sheet and settings."
    },
    {
      "name": "Kbd",
