{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Commands the main window may call. Keep this list minimal.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-message",
    "notification:default"
  ]
}
